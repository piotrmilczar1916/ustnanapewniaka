# Anthropic — ocena komisji AI (tylko serwer)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Supabase — auth + baza danych
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
# Publishable key (sb_publishable_...) — bezpieczny w przeglądarce
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Alternatywna nazwa (to samo co ANON_KEY):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (sb_secret_...) — tylko serwer / webhook płatności, NIGDY w frontendzie
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
